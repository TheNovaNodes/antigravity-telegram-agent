# ==============================================================================
# TheNovaNodes Antigravity Telegram Agent — Environment Configuration Example
# ==============================================================================
# Security Notice:
# In production, this file should have strict 0600 permissions and be located
# at /etc/antigravity-bot/env (or configured via ENV_FILE).
# Set ALLOW_DOTENV=1 only for local development.
# ==============================================================================

# --- [Core Telegram Bot Configuration] ---
# Comma-separated list of Telegram Bot tokens to run concurrently in polling mode.
BOT_TOKENS=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ_1234567

# Comma-separated list of authorized administrator Telegram user IDs.
# Refuses to start if empty (Fail-Closed ACL protection).
ALLOWED_ADMIN_IDS=123456789

# Development mode override: set to 1 to allow loading from local .env
ALLOW_DOTENV=1

# Custom path to environment file (defaults to /etc/antigravity-bot/env)
# ENV_FILE=/etc/antigravity-bot/env

# --- [Data & Workspace Storage Paths] ---
# Root directory for session databases and local state (default: ./data)
DATA_DIR=./data

# Directory containing bot personal offices and profiles (default: ~/.agents)
AGENTS_DIR=~/.agents

# Base path for workspace projects managed by the agent
PROJECTS_DIR=/root/projects

# Path for agent memory and brain artifacts
# BRAIN_DIR=/root/.gemini/antigravity-cli/brain

# Multi-account rotation pool directory (defaults to /etc/antigravity-bot/accounts)
# ACCOUNTS_DIR=/etc/antigravity-bot/accounts

# --- [TTS (Text-to-Speech) Configuration] ---
# Active TTS engine: "hybrid" (Edge TTS + ElevenLabs fallback), "edge", "elevenlabs", or "piper"
TTS_ENGINE=hybrid

# Microsoft Edge TTS default voice
EDGE_TTS_VOICE=ru-RU-DmitryNeural

# ElevenLabs API Keys (supports comma-separated pool for automatic key rotation)
# ELEVENLABS_API_KEY=sk_1234567890abcdef1234567890abcdef
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_TIMEOUT_SECONDS=60
# ELEVENLABS_MAX_CHARS=1500

# Piper Local Neural TTS paths (optional)
# PIPER_PATH=/usr/local/bin/piper
# PIPER_MODEL=/usr/local/share/piper-voices/ru_RU-dmitri-medium.onnx

# --- [Housekeeping & Resilience Workers] ---
# Max idle session age before eviction by memory-aware GC worker (default: 2h)
SESSION_MAX_IDLE=2h

# Maximum inactivity timeout before watchdog cancels stalled turn (default: 15m)
TURN_TIMEOUT_MINUTES=15

# Absolute hard ceiling for turn execution (default: 60m)
# TURN_HARD_DEADLINE_MINUTES=60

# --- [Observability & Metrics] ---
# Optional Prometheus metrics exporter binding (e.g., ":9090" or "127.0.0.1:9090")
# METRICS_ADDR=:9090
# METRICS_PORT=9090
