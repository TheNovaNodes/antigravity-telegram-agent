{
  "enabled": true,
  "servers": {
    "anythingllm": {
      "name": "AnythingLLM Semantic Memory",
      "type": "memory",
      "plane": "data",
      "enabled": true,
      "url": "http://127.0.0.1:8091/sse",
      "api_key": "",
      "workspace": "default"
    },
    "anythingllm-control": {
      "name": "TheNovaNodes AnythingLLM Control Plane",
      "type": "admin",
      "plane": "control",
      "enabled": true,
      "url": "http://127.0.0.1:8091/sse",
      "api_key": ""
    },
    "searxng": {
      "name": "SearXNG Web Search",
      "type": "search",
      "plane": "data",
      "enabled": true,
      "url": "http://127.0.0.1:8889",
      "engines": "google,bing,duckduckgo"
    },
    "nextcloud": {
      "name": "Nextcloud User CRM Gateway",
      "type": "crm",
      "plane": "data",
      "enabled": true,
      "url": "http://127.0.0.1:8000/mcp/sse",
      "username": "",
      "app_password": ""
    },
    "nextcloud-control": {
      "name": "Nextcloud Admin Control Plane",
      "type": "admin",
      "plane": "control",
      "enabled": false,
      "url": "http://127.0.0.1:8000/mcp/sse",
      "username": "",
      "app_password": ""
    },
    "google-jules-doctormes": {
      "name": "Google Jules AI Agent (Doctormes)",
      "type": "agent",
      "plane": "data",
      "enabled": true,
      "url": "local",
      "command": "/root/LabDoctorM/projects/google-jules-mcp/.venv/bin/google-jules-mcp"
    },
    "google-jules-novanodes": {
      "name": "Google Jules AI Agent (TheNovaNodes)",
      "type": "agent",
      "plane": "data",
      "enabled": true,
      "url": "local",
      "command": "/root/LabDoctorM/projects/google-jules-mcp/.venv/bin/google-jules-mcp"
    }
  }
}