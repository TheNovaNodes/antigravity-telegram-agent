[Unit]
Description=AntigravityTelegramAgent - Telegram Bridge for Antigravity AGY
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/LabDoctorM/projects/antigravity-telegram-agent
Environment="PYTHONPATH=/root/LabDoctorM/projects/antigravity-telegram-agent"
# Предполагается использование виртуального окружения (uv или venv)
ExecStart=/root/LabDoctorM/projects/antigravity-telegram-agent/.venv/bin/python src/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
